# Umami Analytics
UMAMI_DB_PASSWORD=your-secure-password-here
UMAMI_SECRET=your-random-secret-here

# Generate secrets:
# openssl rand -hex 32

# Public Vite build settings. Defaults shown below target production.
# For local API development put an override in .env.local.
# Apple web login requires a registered HTTPS domain / return URL.
VITE_API_BASE_URL=https://api.trip-track.app
VITE_APPLE_SERVICES_ID=app.trip-track.web

# Address search / road routing: set WEB_GEOAPIFY_API_KEY on the API server,
# never here or in VITE_* (those values are public in the browser bundle).
